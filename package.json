{
  "name": "@chaincraft/runtime",
  "version": "0.1.0",
  "description": "ChainCraft game runtime — deterministic execution engine for gamedef specs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc --build tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "uuid": "^11.0.3",
    "zod": "^3.24.2"
  },
  "imports": {
    "#chaincraft/*": "./dist/*",
    "#gamedef/*": "../gamedef/dist/*"
  }
}
